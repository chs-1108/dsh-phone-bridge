<?xml version="1.0" encoding="utf-8"?>
<!--
  The bridge is reached over a private Tailscale address or a plain-HTTP tunnel,
  and which address that is only becomes known when the user pairs - it cannot be
  listed here. Android evaluates this policy at request time, so a whitelist that
  only names build-time hosts rejects every address a scanned QR code points at.

  Cleartext is therefore permitted, because the whole point of the app is to
  reach a personal endpoint whose address is decided at pairing time. A build
  that bakes in one specific host replaces this file with a host-pinned version
  automatically - see build-apk.ps1 when -BaseUrl is given.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
