# Normalize line endings so Windows CRLF does not churn every diff.
* text=auto

*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.java  text eol=lf
*.xml   text eol=lf

# PowerShell scripts are safest with CRLF on Windows.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Binary assets must never be touched.
*.png   binary
*.jpg   binary
*.apk   binary
*.jar   binary
*.exe   binary
*.keystore binary
*.zip   binary
